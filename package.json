{
  "name": "gaia",
  "version": "0.0.0",
  "private": true,
  "description": "GAIA Protocol Two modular monolith scaffold.",
  "scripts": {
    "python": "node scripts/bootstrap/python_launcher.js",
    "check": "npm run python -- scripts/bootstrap/validate_constitution.py",
    "lint": "npm run python -- scripts/bootstrap/validate_constitution.py",
    "test": "npm run python -- -m unittest discover -s tests -p test_*.py",
    "eval": "npm run python -- scripts/eval/run_eval_smoke.py",
    "gaia": "npm run python -- -m apps.cli.gaia",
    "seed": "npm run python -- -m apps.cli.gaia seed demo",
    "dev": "npm run python -- -m apps.cli.gaia dev",
    "env": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap/check_environment.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
