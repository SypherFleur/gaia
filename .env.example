OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

MODEL_PROVIDER=local
MODEL_BASE_URL=
MODEL_NAME=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
GAIA_RUN_OLLAMA_SMOKE=0
GAIA_LLAVA_MODEL=llava:latest
GAIA_RUN_LLAVA_SMOKE=0

# Protocol Three local alpha provider modes: fixture, live, disabled, or local where supported.
# Defaults preserve $0 automatic spend and avoid network egress except local Ollama.
GAIA_NWS_MODE=fixture
GAIA_NASA_POWER_MODE=fixture
GAIA_GBIF_MODE=fixture
